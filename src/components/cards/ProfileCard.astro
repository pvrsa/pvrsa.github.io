---
import Icon from '../Icon.astro';

interface Profile {
  name: string;
  handle: string;
  role: string;
  company: string;
  location: string;
  email: string;
  website: string;
  meta: string;
  avatar: string;
}

const { profile } = Astro.props as { profile: Profile };
---

<article class="profile-card">
  <div class="avatar-wrap">
    <img
      src={profile.avatar}
      alt={`${profile.name} GitHub avatar`}
      width="176"
      height="176"
      loading="eager"
      class="avatar-dark"
    />
    <img
      src="/images/logo-light.png"
      alt={`${profile.name} GitHub avatar`}
      width="176"
      height="176"
      loading="eager"
      class="avatar-light"
    />
  </div>

  <div class="profile-heading">
    <h1>{profile.name}</h1>
    <p>{profile.handle}</p>
    <span>
      <Icon name="sparkle" /> {profile.role}
    </span>
    <div class="profile-socials">
      <a
        href="https://www.linkedin.com/in/sai-aasrith-56815415a"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <Icon name="linkedin" size={16} />
      </a>
      <a
        href="https://github.com/pvrsa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <Icon name="github" size={16} />
      </a>
      <a
        href="https://www.instagram.com/im_pvr/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram (Personal)"
        title="Instagram (@im_pvr)"
      >
        <Icon name="instagram" size={16} />
      </a>
      <a
        href="https://www.instagram.com/im_pvr_snaps"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram (Photography)"
        title="Photography (@im_pvr_snaps)"
      >
        <Icon name="camera" size={16} />
      </a>
      <a href={`mailto:${profile.email}`} aria-label="Email" title="Email">
        <Icon name="mail" size={16} />
      </a>
    </div>
  </div>
</article>

<style>
  .profile-card {
    display: grid;
    justify-items: end;
    min-height: 420px;
    width: 100%;
    padding: 20px 0;
    text-align: right;
    overflow: hidden;
  }

  .avatar-wrap {
    position: relative;
    width: 176px;
    height: 176px;
    margin: 0 0 18px auto;
    padding: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: none;
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  /* Theme-adaptive avatar display */
  .avatar-light {
    display: block;
  }
  .avatar-dark {
    display: none;
  }

  :global([data-theme='dark']) .avatar-light {
    display: none;
  }
  :global([data-theme='dark']) .avatar-dark {
    display: block;
  }

  .profile-heading h1 {
    margin: 0;
    color: var(--paper-ink);
    font-size: 1.42rem;
    letter-spacing: 0;
  }

  .profile-heading p {
    margin: 4px 0 14px;
    color: var(--paper-ink-soft);
    font-size: 0.94rem;
  }

  .profile-heading span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: flex-end;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--paper-ink);
    font-size: 0.82rem;
  }

  .profile-socials {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 14px;
  }

  .profile-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    color: var(--paper-ink-soft);
    background: var(--paper-control);
    border: 1px solid var(--paper-line);
    transition:
      color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
    text-decoration: none;
  }

  .profile-socials a:hover {
    color: var(--paper-accent);
    background: var(--paper-control-hover);
    transform: translateY(-2px);
  }

  .profile-heading svg {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    color: var(--paper-accent);
  }

  @media (max-width: 820px) {
    .profile-card {
      justify-items: center;
      min-height: auto;
      padding: 4px 0 0;
      text-align: center;
    }

    .avatar-wrap {
      margin-right: auto;
      margin-left: auto;
    }

    .profile-heading span {
      justify-content: center;
    }
  }
</style>
