---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import Icon from '../components/Icon.astro';
import { getSiteConfig } from '../data/site';

const { site, theme } = await getSiteConfig();
const palette = theme.palette;

const photos = (await getCollection('gallery'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Extract unique regions/locations
const locations = Array.from(
  new Set(
    photos
      .map((p) => {
        if (!p.data.location) return null;
        if (p.data.location.includes('Banff')) return 'Banff & Canadian Rockies';
        if (
          p.data.location.includes('Seattle') ||
          p.data.location.includes('Pacific Northwest') ||
          p.data.location.includes('WA')
        )
          return 'Pacific Northwest';
        return p.data.location;
      })
      .filter(Boolean),
  ),
);
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <BaseHead
      title={`Frames & Travels | ${site.title}`}
      description="Visual journal, photography, and travel stills from Banff, the Pacific Northwest, and journeys beyond."
    />
    <style>
      main {
        width: min(100%, 1040px);
        margin: 0 auto;
        padding: 120px 1.5rem 80px;
      }

      .gallery-header {
        margin-bottom: 2.25rem;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--paper-theme, #059669);
        margin-bottom: 0.6rem;
      }

      .gallery-header h1 {
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--paper-text);
        margin: 0 0 0.6rem;
      }

      .gallery-header p {
        font-size: 1.05rem;
        color: var(--paper-muted);
        margin: 0;
        line-height: 1.6;
      }

      /* Region Filter Bar */
      .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.5rem;
      }

      .filter-btn {
        appearance: none;
        border: 1px solid var(--paper-card-border);
        background: var(--paper-card-bg);
        color: var(--paper-muted);
        box-shadow: var(--paper-card-shadow);
        padding: 0.35rem 0.95rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .filter-btn:hover,
      .filter-btn.active {
        background: var(--paper-theme, #059669);
        color: #ffffff;
        border-color: var(--paper-theme, #059669);
      }

      /* Portrait-optimized Carousel */
      .carousel-container {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        background: #0b0f17;
        border: 1px solid var(--paper-card-border);
        margin-bottom: 3.5rem;
        box-shadow: 0 10px 36px rgba(0, 0, 0, 0.16);
      }

      .carousel-track {
        display: flex;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .carousel-slide {
        min-width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2.5rem 1.5rem 3.5rem;
        background: radial-gradient(circle at center, #172033 0%, #090d16 100%);
        min-height: 580px;
      }

      .slide-image-wrapper {
        position: relative;
        max-width: 100%;
        display: flex;
        justify-content: center;
      }

      .slide-image {
        max-height: 560px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
      }

      .slide-caption-bar {
        margin-top: 1.5rem;
        text-align: center;
        color: #f8fafc;
        max-width: 600px;
      }

      .slide-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 0.35rem;
      }

      .slide-desc {
        font-size: 0.9rem;
        color: #cbd5e1;
        margin: 0 0 0.5rem;
        line-height: 1.5;
      }

      .slide-meta {
        font-size: 0.82rem;
        color: #94a3b8;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
      }

      .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition:
          background 0.2s,
          transform 0.2s;
        backdrop-filter: blur(6px);
      }

      .carousel-btn:hover {
        background: rgba(15, 23, 42, 0.95);
        transform: translateY(-50%) scale(1.08);
      }

      .carousel-btn.prev {
        left: 1.25rem;
      }

      .carousel-btn.next {
        right: 1.25rem;
      }

      /* Portrait Masonry Grid */
      .section-subhead {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--paper-text);
        margin: 0 0 1.5rem;
      }

      .photo-grid {
        column-count: 3;
        column-gap: 1.5rem;
      }

      @media (max-width: 860px) {
        .photo-grid {
          column-count: 2;
        }
      }

      @media (max-width: 540px) {
        .photo-grid {
          column-count: 1;
        }
      }

      .photo-card {
        break-inside: avoid;
        margin-bottom: 1.5rem;
        border-radius: 12px;
        overflow: hidden;
        background: var(--paper-card-bg);
        border: 1px solid var(--paper-card-border);
        box-shadow: var(--paper-card-shadow);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease,
          border-color 0.2s ease;
        display: block;
      }

      .photo-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--paper-card-hover-shadow);
        border-color: var(--paper-line-strong);
      }

      .photo-img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
      }

      .photo-card:hover .photo-img {
        transform: scale(1.015);
      }

      .card-info {
        padding: 0.9rem 1rem 1rem;
      }

      .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--paper-text);
        margin: 0 0 0.25rem;
      }

      .card-desc {
        font-size: 0.82rem;
        color: var(--paper-muted);
        margin: 0 0 0.5rem;
        line-height: 1.45;
      }

      .card-loc {
        font-size: 0.78rem;
        color: var(--paper-theme, #059669);
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 500;
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main>
      <header class="gallery-header">
        <div class="kicker">
          <Icon name="compass" size={15} />
          <span>Frames & Travels</span>
        </div>
        <h1>Gallery & Journeys</h1>
        <p>
          A visual log of travels, trail notes, and landscape stills across Banff, the Pacific
          Northwest, and beyond.
        </p>

        <div class="filter-bar" role="group" aria-label="Filter photos by travel destination">
          <button class="filter-btn active" data-filter="all" type="button">
            All Places
          </button>
          <button class="filter-btn" data-filter="Banff" type="button">
            Banff & Canadian Rockies
          </button>
          <button class="filter-btn" data-filter="Pacific Northwest" type="button">
            Pacific Northwest
          </button>
        </div>
      </header>

      {photos.length > 0 && (
        <section class="carousel-container" aria-label="Featured Photography Carousel">
          <button class="carousel-btn prev" id="prevBtn" aria-label="Previous Slide">
            ←
          </button>
          <button class="carousel-btn next" id="nextBtn" aria-label="Next Slide">
            →
          </button>

          <div class="carousel-track" id="track">
            {photos.map((item) => (
              <div class="carousel-slide">
                <div class="slide-image-wrapper">
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    class="slide-image"
                    loading="eager"
                  />
                </div>
                <div class="slide-caption-bar">
                  <h2 class="slide-title">{item.data.title}</h2>
                  {item.data.description && <p class="slide-desc">{item.data.description}</p>}
                  <div class="slide-meta">
                    {item.data.location && <span>📍 {item.data.location}</span>}
                    {item.data.camera && <span>📷 {item.data.camera}</span>}
                    <span>
                      • <FormattedDate date={item.data.date} />
                    </span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <h2 class="section-subhead">All Moments</h2>
      <section class="photo-grid">
        {photos.map((item) => {
          const regionTag = item.data.location?.includes('Banff') ? 'Banff' : 'Pacific Northwest';

          return (
            <article class="photo-card" data-region={regionTag}>
              <img src={item.data.image} alt={item.data.title} class="photo-img" loading="lazy" />
              <div class="card-info">
                <h3 class="card-title">{item.data.title}</h3>
                {item.data.description && <p class="card-desc">{item.data.description}</p>}
                {item.data.location && (
                  <div class="card-loc">
                    <Icon name="map" size={13} />
                    <span>{item.data.location}</span>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </section>
    </main>
    <Footer />

    <script is:inline>
      const track = document.getElementById('track');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const slides = document.querySelectorAll('.carousel-slide');
      let currentIndex = 0;

      function updateSlide(index) {
        if (!track || slides.length === 0) return;
        currentIndex = (index + slides.length) % slides.length;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => updateSlide(currentIndex - 1));
        nextBtn.addEventListener('click', () => updateSlide(currentIndex + 1));
      }

      // Keyboard arrow navigation
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') updateSlide(currentIndex - 1);
        if (e.key === 'ArrowRight') updateSlide(currentIndex + 1);
      });

      // Filter buttons
      const filterBtns = document.querySelectorAll('.filter-btn');
      const photoCards = document.querySelectorAll('.photo-card');

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');

          const filter = btn.getAttribute('data-filter');
          photoCards.forEach((card) => {
            if (filter === 'all' || card.getAttribute('data-region') === filter) {
              card.style.display = 'block';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    </script>
  </body>
</html>
