---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import BlogTopNav from '../components/blog/BlogTopNav.astro';
import Icon from '../components/Icon.astro';
import { getSiteConfig } from '../data/site';

const { site, theme } = await getSiteConfig();
const palette = theme.palette;

const photos = (await getCollection('gallery'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en" data-palette={palette}>
  <head>
    <BaseHead
      title={`Gallery | ${site.title}`}
      description="Visual frames, film notes, and photography from travels and the Pacific Northwest."
    />
    <style>
      main {
        width: min(100%, 1040px);
        margin: 0 auto;
        padding: 120px 1.5rem 80px;
      }

      .gallery-header {
        margin-bottom: 2.5rem;
      }

      .kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--paper-theme, #059669);
        margin-bottom: 0.6rem;
      }

      .gallery-header h1 {
        font-size: 2.2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--paper-text);
        margin: 0 0 0.6rem;
      }

      .gallery-header p {
        font-size: 1.05rem;
        color: var(--paper-muted);
        margin: 0;
        line-height: 1.6;
      }

      /* Portrait-optimized Carousel */
      .carousel-container {
        position: relative;
        overflow: hidden;
        border-radius: 16px;
        background: #0b0f17;
        border: 1px solid var(--paper-card-border);
        margin-bottom: 3.5rem;
        box-shadow: 0 10px 36px rgba(0, 0, 0, 0.16);
      }

      .carousel-track {
        display: flex;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .carousel-slide {
        min-width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
        padding: 2.5rem 1.5rem 3.5rem;
        background: radial-gradient(circle at center, #172033 0%, #090d16 100%);
        min-height: 580px;
      }

      .slide-image-wrapper {
        position: relative;
        max-width: 100%;
        display: flex;
        justify-content: center;
      }

      .slide-image {
        max-height: 560px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
      }

      .slide-caption-bar {
        margin-top: 1.5rem;
        text-align: center;
        color: #f8fafc;
        max-width: 600px;
      }

      .slide-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin: 0 0 0.35rem;
      }

      .slide-meta {
        font-size: 0.85rem;
        color: #94a3b8;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
      }

      .carousel-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: rgba(15, 23, 42, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: background 0.2s, transform 0.2s;
        backdrop-filter: blur(6px);
      }

      .carousel-btn:hover {
        background: rgba(15, 23, 42, 0.95);
        transform: translateY(-50%) scale(1.08);
      }

      .carousel-btn.prev {
        left: 1.25rem;
      }

      .carousel-btn.next {
        right: 1.25rem;
      }

      /* Portrait Masonry Grid */
      .section-subhead {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--paper-text);
        margin: 0 0 1.5rem;
      }

      .photo-grid {
        column-count: 3;
        column-gap: 1.5rem;
      }

      @media (max-width: 860px) {
        .photo-grid {
          column-count: 2;
        }
      }

      @media (max-width: 540px) {
        .photo-grid {
          column-count: 1;
        }
      }

      .photo-card {
        break-inside: avoid;
        margin-bottom: 1.5rem;
        border-radius: 12px;
        overflow: hidden;
        background: var(--paper-card-bg);
        border: 1px solid var(--paper-card-border);
        box-shadow: var(--paper-card-shadow);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        display: block;
      }

      .photo-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--paper-card-hover-shadow);
        border-color: var(--paper-line-strong);
      }

      .photo-img {
        width: 100%;
        height: auto;
        display: block;
        transition: transform 0.3s ease;
      }

      .photo-card:hover .photo-img {
        transform: scale(1.015);
      }

      .card-info {
        padding: 0.9rem 1rem 1rem;
      }

      .card-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--paper-text);
        margin: 0 0 0.25rem;
      }

      .card-loc {
        font-size: 0.78rem;
        color: var(--paper-muted);
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }
    </style>
  </head>
  <body>
    <BlogTopNav />
    <main>
      <header class="gallery-header">
        <div class="kicker">
          <Icon name="camera" size={15} />
          <span>Frames & Visuals</span>
        </div>
        <h1>Gallery</h1>
        <p>Photographic stills from journeys across the Pacific Northwest and beyond.</p>
      </header>

      {photos.length > 0 && (
        <section class="carousel-container" aria-label="Featured Photography Carousel">
          <button class="carousel-btn prev" id="prevBtn" aria-label="Previous Slide">
            ←
          </button>
          <button class="carousel-btn next" id="nextBtn" aria-label="Next Slide">
            →
          </button>

          <div class="carousel-track" id="track">
            {photos.map((item) => (
              <div class="carousel-slide">
                <div class="slide-image-wrapper">
                  <img
                    src={item.data.image}
                    alt={item.data.title}
                    class="slide-image"
                    loading="eager"
                  />
                </div>
                <div class="slide-caption-bar">
                  <h2 class="slide-title">{item.data.title}</h2>
                  <div class="slide-meta">
                    {item.data.location && <span>📍 {item.data.location}</span>}
                    {item.data.camera && <span>📷 {item.data.camera}</span>}
                    <span>• <FormattedDate date={item.data.date} /></span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <h2 class="section-subhead">All Frames</h2>
      <section class="photo-grid">
        {photos.map((item) => (
          <article class="photo-card">
            <img
              src={item.data.image}
              alt={item.data.title}
              class="photo-img"
              loading="lazy"
            />
            <div class="card-info">
              <h3 class="card-title">{item.data.title}</h3>
              {item.data.location && (
                <div class="card-loc">
                  <Icon name="map" size={13} />
                  <span>{item.data.location}</span>
                </div>
              )}
            </div>
          </article>
        ))}
      </section>
    </main>
    <Footer />

    <script is:inline>
      const track = document.getElementById('track');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const slides = document.querySelectorAll('.carousel-slide');
      let currentIndex = 0;

      function updateSlide(index) {
        if (!track || slides.length === 0) return;
        currentIndex = (index + slides.length) % slides.length;
        track.style.transform = `translateX(-${currentIndex * 100}%)`;
      }

      if (prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => updateSlide(currentIndex - 1));
        nextBtn.addEventListener('click', () => updateSlide(currentIndex + 1));
      }

      // Keyboard arrow navigation
      window.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') updateSlide(currentIndex - 1);
        if (e.key === 'ArrowRight') updateSlide(currentIndex + 1);
      });
    </script>
  </body>
</html>
